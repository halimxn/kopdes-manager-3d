    "motion": "^14.6.0",
    "next": "^16.3.7",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "three": "^0.180.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
