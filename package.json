    "@types/three": "^0.180.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
