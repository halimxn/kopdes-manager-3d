    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "ukur:bundel": "node scripts/measure-bundle.mjs",
    "cek": "tsc --noEmit && eslint src tests && npm run format:check && vitest run --changed",
    "cek:penuh": "tsc --noEmit && eslint src tests && npm run format:check && vitest run && next build && node scripts/measure-bundle.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
